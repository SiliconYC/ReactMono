{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": ".test-dist",
    "declaration": true,
    "skipLibCheck": true,
    "types": ["react", "react-dom", "three", "vite/client"],
    "lib": ["ES2022", "DOM"],
    "noEmitOnError": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/demo3d/**/*.tsx"]
}
