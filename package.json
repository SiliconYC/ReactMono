{
  "name": "reactmono",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "纯静态本地运行的 React + TypeScript 大富翁游戏",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "main:dev": "vite --config vite.main.config.ts",
    "demo:dev": "vite --config vite.demo.config.ts",
    "demo:build": "tsc -p tsconfig.demo.json && vite build --config vite.demo.config.ts",
    "maps:validate": "tsc -p tsconfig.json && node scripts/validate-maps.mjs",
    "maps:generate": "tsc -p tsconfig.json && node scripts/generate-map.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "8.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.186.0",
    "typescript": "5.8.3",
    "vite": "8.3.4"
  }
}
