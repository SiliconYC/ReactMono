{
  "name": "reactmono",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "纯静态本地运行的 React + TypeScript 大富翁游戏",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && node scripts/serve.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
